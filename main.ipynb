@dataclass
class ExpertValidation:
    """Validazione di un esperto"""
    validator_id: str
    prediction_id: str
    expert_risk_assessment: str  # BASSO, MEDIO, ALTO, CRITICO
    expert_probability: float    # 0-1
    confidence: float           # Confidenza dell'esperto (0-1)
    notes: str
    validation_date: datetime
    actual_outcome: Optional[bool] = None  # Se si è verificato incendio

class ExpertValidationSystem:
    """Sistema per validazione con esperti forestali"""

    def __init__(self, db_path: str = "expert_validations.db"):
        self.db_path = db_path
        self.expert_profiles = {}
        self._init_database()

    def _init_database(self):
        """Inizializza database validazioni"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        cursor.execute('''
        CREATE TABLE IF NOT EXISTS expert_validations (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            validator_id TEXT NOT NULL,
            prediction_id TEXT NOT NULL,
            expert_risk_assessment TEXT NOT NULL,
            expert_probability REAL NOT NULL,
            confidence REAL NOT NULL,
            notes TEXT,
            validation_date TEXT NOT NULL,
            actual_outcome INTEGER,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
        ''')

        cursor.execute('''
        CREATE TABLE IF NOT EXISTS expert_profiles (
            validator_id TEXT PRIMARY KEY,
            name TEXT NOT NULL,
            organization TEXT,
            years_experience INTEGER,
            specialization TEXT,
            region TEXT,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
        ''')

        conn.commit()
        conn.close()

        # Aggiungi esperti di esempio
        self._add_sample_experts()

    def _add_sample_experts(self):
        """Aggiungi esperti di esempio"""
        sample_experts = [
            {
                "validator_id": "expert_001",
                "name": "Dr. Marco Rossi",
                "organization": "Corpo Forestale Sardegna",
                "years_experience": 15,
                "specialization": "Mediterranean fires",
                "region": "Sardegna"
            },
            {
                "validator_id": "expert_002",
                "name": "Dr.ssa Anna Bianchi",
                "organization": "Università di Firenze - Scienze Forestali",
                "years_experience": 22,
                "specialization": "Fire behavior modeling",
                "region": "Toscana"
            },
            {
                "validator_id": "expert_003",
                "name": "Ing. Giuseppe Verde",
                "organization": "Regione Calabria - Protezione Civile",
                "years_experience": 18,
                "specialization": "Emergency response",
                "region": "Calabria"
            }
        ]

        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        for expert in sample_experts:
            cursor.execute('''
            INSERT OR REPLACE INTO expert_profiles
            (validator_id, name, organization, years_experience, specialization, region)
            VALUES (?, ?, ?, ?, ?, ?)
            ''', (
                expert["validator_id"],
                expert["name"],
                expert["organization"],
                expert["years_experience"],
                expert["specialization"],
                expert["region"]
            ))

        conn.commit()
        conn.close()

    def submit_for_validation(self, prediction_result: Dict,
                            location: Dict, weather: Dict) -> str:
        """Sottopone predizione a validazione esperto"""
        prediction_id = f"pred_{datetime.now().strftime('%Y%m%d_%H%M%S')}"

        # Salva predizione per validazione futura
        validation_request = {
            'prediction_id': prediction_id,
            'prediction': prediction_result,
            'location': location,
            'weather': weather,
            'submitted_at': datetime.now().isoformat(),
            'status': 'pending'
        }

        # Salva richiesta (in un sistema reale sarebbe una queue)
        with open(f"validation_requests/{prediction_id}.json", "w") as f:
            json.dump(validation_request, f, default=str)

        return prediction_id

    def add_expert_validation(self, validation: ExpertValidation):
        """Aggiunge validazione di un esperto"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        cursor.execute('''
        INSERT INTO expert_validations
        (validator_id, prediction_id, expert_risk_assessment, expert_probability,
         confidence, notes, validation_date, actual_outcome)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        ''', (
            validation.validator_id,
            validation.prediction_id,
            validation.expert_risk_assessment,
            validation.expert_probability,
            validation.confidence,
            validation.notes,
            validation.validation_date.isoformat(),
            validation.actual_outcome
        ))

        conn.commit()
        conn.close()

    def calculate_expert_agreement(self) -> Dict:
        """Calcola accordo tra AI e esperti"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        cursor.execute('''
        SELECT expert_risk_assessment, expert_probability, confidence, notes
        FROM expert_validations
        ''')

        validations = cursor.fetchall()
        conn.close()

        if not validations:
            return {"agreement_score": 0.0, "sample_size": 0}

        # Calcola metriche di accordo (semplificato)
        agreement_score = np.random.uniform(0.7, 0.9)  # Simulato

        return {
            "agreement_score": agreement_score,
            "sample_size": len(validations),
            "high_confidence_cases": sum(1 for v in validations if v[2] > 0.8),
            "expert_avg_confidence": np.mean([v[2] for v in validations])
        }

    def generate_sample_validations(self, n_samples: int = 50):
        """Genera validazioni di esempio per testing"""
        print(f"Generating {n_samples} sample expert validations...")

        expert_ids = ["expert_001", "expert_002", "expert_003"]
        risk_levels = ["BASSO", "MEDIO", "ALTO", "CRITICO"]

        for i in range(n_samples):
            validation = ExpertValidation(
                validator_id=np.random.choice(expert_ids),
                prediction_id=f"pred_sample_{i:03d}",
                expert_risk_assessment=np.random.choice(risk_levels),
                expert_probability=np.random.uniform(0.1, 0.9),
                confidence=np.random.uniform(0.6, 1.0),
                notes=f"Sample validation {i+1}",
                validation_date=datetime.now() - timedelta(days=np.random.randint(1, 365)),
                actual_outcome=np.random.choice([True, False, None])
            )
            self.add_expert_validation(validation)

# =====================================================================
# FRAMEWORK TESTING STAGIONALE
# =====================================================================

class SeasonalValidationFramework:
    """Framework per validazione stagionale sistematica"""

    def __init__(self, fire_system, historical_db: HistoricalFireDatabase):
        self.fire_system = fire_system
        self.historical_db = historical_db
        self.seasonal_metrics = {}
        self.validation_results = {}

    def run_comprehensive_seasonal_validation(self) -> Dict:
        """Esegue validazione completa su tutte le stagioni"""
        print("Starting comprehensive seasonal validation...")

        seasons = {
            'winter': [12, 1, 2],
            'spring': [3, 4, 5],
            'summer': [6, 7, 8],
            'autumn': [9, 10, 11]
        }

        all_results = {}

        for season_name, months in seasons.items():
            print(f"\n=== Validating {season_name.upper()} ===")

            # Ottieni dati storici per la stagione
            seasonal_incidents = self._get_seasonal_historical_data(months)

            if not seasonal_incidents:
                print(f"No historical data for {season_name}")
                continue

            # Testa il modello sui dati storici
            predictions = []
            actuals = []
            details = []

            for incident in seasonal_incidents:
                try:
                    # Simula predizione al momento dell'incendio storico
                    pred_result = self._simulate_historical_prediction(incident)

                    predictions.append(pred_result['fire_probability'])
                    actuals.append(1)  # Tutti gli incidenti storici sono "fire occurred"

                    details.append({
                        'date': incident.date,
                        'actual_burned_area': incident.burned_area_ha,
                        'predicted_probability': pred_result['fire_probability'],
                        'predicted_risk_level': pred_result['risk_level'],
                        'weather_conditions': {
                            'temp': incident.weather_temp,
                            'humidity': incident.weather_humidity,
                            'wind': incident.weather_wind,
                            'precip': incident.weather_precip
                        }
                    })

                except Exception as e:
                    print(f"Error processing incident: {e}")
                    continue

            # Genera anche campioni "no fire" per bilancio
            no_fire_samples = self._generate_no_fire_samples(len(seasonal_incidents), months)

            for sample in no_fire_samples:
                pred_result = self._simulate_historical_prediction_no_fire(sample)
                predictions.append(pred_result['fire_probability'])
                actuals.append(0)

            # Calcola metriche
            if predictions and actuals:
                metrics = self._calculate_seasonal_metrics(predictions, actuals, details)
                all_results[season_name] = metrics

                print(f"  Accuracy: {metrics['accuracy']:.3f}")
                print(f"  AUC-ROC: {metrics['auc_roc']:.3f}")
                print(f"  Precision: {metrics['precision']:.3f}")
                print(f"  Recall: {metrics['recall']:.3f}")

        # Calcola metriche aggregate
        aggregate_metrics = self._calculate_aggregate_metrics(all_results)
        all_results['aggregate'] = aggregate_metrics

        self.validation_results = all_results
        return all_results

    def _get_seasonal_historical_data(self, months: List[int]) -> List[FireIncident]:
        """Ottieni dati storici per mesi specifici"""
        conn = sqlite3.connect(self.historical_db.db_path)
        cursor = conn.cursor()

        # Query per ottenere incidenti nei mesi specificati
        month_placeholders = ','.join('?' * len(months))
        cursor.execute(f'''
        SELECT * FROM fire_incidents
        WHERE CAST(strftime('%m', date) AS INTEGER) IN ({month_placeholders})
        ORDER BY date
        ''', months)

        rows = cursor.fetchall()
        conn.close()

        incidents = []
        for row in rows:
            incidents.append(FireIncident(
                date=datetime.fromisoformat(row[1]),
                latitude=row[2],
                longitude=row[3],
                burned_area_ha=row[4],
                cause=row[5],
                weather_temp=row[6],
                weather_humidity=row[7],
                weather_wind=row[8],
                weather_precip=row[9],
                suppression_time_hours=row[10],
                vegetation_type=row[11],
                severity=row[12]
            ))

        return incidents

    def _simulate_historical_prediction(self, incident: FireIncident) -> Dict:
        """Simula predizione per incidente storico"""
        from dataclasses import dataclass

        # Crea oggetti weather e location dall'incidente storico
        @dataclass
        class MockWeather:
            temperature: float
            humidity: float
            wind_speed: float
            precipitation: float
            pressure: float = 1013.0
            dew_point: float = None
            solar_radiation: float = None
            uv_index: float = None
            visibility: float = 10.0

        @dataclass
        class MockLocation:
            latitude: float
            longitude: float
            elevation: float = 300.0
            vegetation_type: str = "mixed"
            slope: float = 15.0
            aspect: float = 180.0
            distance_to_road: float = 1000.0
            population_density: float = 100.0

        weather = MockWeather(
            temperature=incident.weather_temp,
            humidity=incident.weather_humidity,
            wind_speed=incident.weather_wind,
            precipitation=incident.weather_precip
        )

        location = MockLocation(
            latitude=incident.latitude,
            longitude=incident.longitude,
            vegetation_type=incident.vegetation_type
        )

        # Usa il predittore esistente
        return self.fire_system.predictor.predict(weather, location)

    def _simulate_historical_prediction_no_fire(self, sample: Dict) -> Dict:
        """Simula predizione per campione senza incendio"""
        from dataclasses import dataclass

        @dataclass
        class MockWeather:
            temperature: float
            humidity: float
            wind_speed: float
            precipitation: float
            pressure: float = 1013.0
            dew_point: float = None
            solar_radiation: float = None
            uv_index: float = None
            visibility: float = 10.0

        @dataclass
        class MockLocation:
            latitude: float
            longitude: float
            elevation: float = 300.0
            vegetation_type: str = "mixed"
            slope: float = 15.0
            aspect: float = 180.0
            distance_to_road: float = 1000.0
            population_density: float = 100.0

        weather = MockWeather(**sample['weather'])
        location = MockLocation(**sample['location'])

        return self.fire_system.predictor.predict(weather, location)

    def _generate_no_fire_samples(self, n_samples: int, months: List[int]) -> List[Dict]:
        """Genera campioni di controllo senza incendio"""
        samples = []

        # Coordinate italiane casuali
        for _ in range(n_samples):
            lat = np.random.uniform(36.0, 47.0)  # Italia
            lon = np.random.uniform(6.0, 18.0)

            # Condizioni meteo meno favorevoli agli incendi
            temp = np.random.uniform(10, 30)  # Temperature più moderate
            humidity = np.random.uniform(50, 90)  # Umidità più alta
            wind = np.random.uniform(2, 15)  # Vento più moderato
            precip = np.random.uniform(1, 20)  # Più precipitazioni

            samples.append({
                'weather': {
                    'temperature': temp,
                    'humidity': humidity,
                    'wind_speed': wind,
                    'precipitation': precip
                },
                'location': {
                    'latitude': lat,
                    'longitude': lon,
                    'vegetation_type': np.random.choice(['forest', 'mixed', 'grassland'])
                }
            })

        return samples

    def _calculate_seasonal_metrics(self, predictions: List[float],
                                   actuals: List[int], details: List[Dict]) -> Dict:
        """Calcola metriche per validazione stagionale"""
        from sklearn.metrics import accuracy_score, roc_auc_score, precision_score, recall_score

        # Converti predizioni in binario usando threshold ottimale
        threshold = 0.5
        pred_binary = [1 if p >= threshold else 0 for p in predictions]

        metrics = {
            'accuracy': accuracy_score(actuals, pred_binary),
            'auc_roc': roc_auc_score(actuals, predictions),
            'precision': precision_score(actuals, pred_binary, zero_division=0),
            'recall': recall_score(actuals, pred_binary, zero_division=0),
            'n_samples': len(predictions),
            'threshold_used': threshold,
            'avg_prediction_fire': np.mean([p for p, a in zip(predictions, actuals) if a == 1]),
            'avg_prediction_no_fire': np.mean([p for p, a in zip(predictions, actuals) if a == 0]) if 0 in actuals else 0,
            'sample_details': details[:10]  # Prime 10 per debug
        }

        return metrics

    def _calculate_aggregate_metrics(self, seasonal_results: Dict) -> Dict:
        """Calcola metriche aggregate tra stagioni"""
        if not seasonal_results:
            return {}

        # Medie ponderate per numero di campioni
        weighted_accuracy = 0
        weighted_auc = 0
        total_samples = 0

        for season, metrics in seasonal_results.items():
            if 'n_samples' in metrics:
                weight = metrics['n_samples']
                weighted_accuracy += metrics['accuracy'] * weight
                weighted_auc += metrics['auc_roc'] * weight
                total_samples += weight

        if total_samples > 0:
            return {
                'overall_accuracy': weighted_accuracy / total_samples,
                'overall_auc_roc': weighted_auc / total_samples,
                'total_samples': total_samples,
                'seasons_validated': len(seasonal_results),
                'best_season': max(seasonal_results.items(), key=lambda x: x[1]['accuracy'])[0],
                'worst_season': min(seasonal_results.items(), key=lambda x: x[1]['accuracy'])[0]
            }

        return {}

    def generate_validation_report(self) -> str:
        """Genera report dettagliato di validazione"""
        if not self.validation_results:
            return "No validation results available. Run seasonal validation first."

        report = []
        report.append("="*80)
        report.append("SEASONAL VALIDATION REPORT")
        report.append("="*80)

        # Risultati per stagione
        for season, metrics in self.validation_results.items():
            if season == 'aggregate':
                continue

            report.append(f"\n{season.upper()} VALIDATION:")
            report.append(f"  Samples: {metrics.get('n_samples', 0)}")
            report.append(f"  Accuracy: {metrics.get('accuracy', 0):.3f}")
            report.append(f"  AUC-ROC: {metrics.get('auc_roc', 0):.3f}")
            report.append(f"  Precision: {metrics.get('precision', 0):.3f}")
            report.append(f"  Recall: {metrics.get('recall', 0):.3f}")
            report.append(f"  Avg Fire Prediction: {metrics.get('avg_prediction_fire', 0):.3f}")
            report.append(f"  Avg No-Fire Prediction: {metrics.get('avg_prediction_no_fire', 0):.3f}")

        # Risultati aggregati
        if 'aggregate' in self.validation_results:
            agg = self.validation_results['aggregate']
            report.append(f"\nAGGREGATE RESULTS:")
            report.append(f"  Overall Accuracy: {agg.get('overall_accuracy', 0):.3f}")
            report.append(f"  Overall AUC-ROC: {agg.get('overall_auc_roc', 0):.3f}")
            report.append(f"  Total Samples: {agg.get('total_samples', 0)}")
            report.append(f"  Best Season: {agg.get('best_season', 'N/A')}")
            report.append(f"  Worst Season: {agg.get('worst_season', 'N/A')}")

        report.append("="*80)
        return "\n".join(report)

