@dataclass
class FireIncident:
    """Incidente storico di incendio"""
    date: datetime
    latitude: float
    longitude: float
    burned_area_ha: float
    cause: str  # natural, human, lightning, arson, accident
    weather_temp: float
    weather_humidity: float
    weather_wind: float
    weather_precip: float
    suppression_time_hours: Optional[float] = None
    vegetation_type: str = "mixed"
    severity: str = "medium"  # low, medium, high, extreme

class HistoricalFireDatabase:
    """Database per gestione dati storici incendi"""

    def __init__(self, db_path: str = "fire_incidents.db"):
        self.db_path = db_path
        self._init_database()

    def _init_database(self):
        """Inizializza database SQLite"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        cursor.execute('''
        CREATE TABLE IF NOT EXISTS fire_incidents (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            date TEXT NOT NULL,
            latitude REAL NOT NULL,
            longitude REAL NOT NULL,
            burned_area_ha REAL NOT NULL,
            cause TEXT NOT NULL,
            weather_temp REAL,
            weather_humidity REAL,
            weather_wind REAL,
            weather_precip REAL,
            suppression_time_hours REAL,
            vegetation_type TEXT,
            severity TEXT,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
        ''')

        # Indici per query geografiche e temporali
        cursor.execute('CREATE INDEX IF NOT EXISTS idx_location ON fire_incidents(latitude, longitude)')
        cursor.execute('CREATE INDEX IF NOT EXISTS idx_date ON fire_incidents(date)')
        cursor.execute('CREATE INDEX IF NOT EXISTS idx_severity ON fire_incidents(severity)')

        conn.commit()
        conn.close()

        # Popola con dati di esempio se database vuoto
        if self._count_incidents() == 0:
            self._populate_sample_data()

    def _count_incidents(self) -> int:
        """Conta incidenti nel database"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        cursor.execute('SELECT COUNT(*) FROM fire_incidents')
        count = cursor.fetchone()[0]
        conn.close()
        return count

    def _populate_sample_data(self):
        """Popola database con dati sintetici realistici"""
        print("Populating database with realistic historical fire data...")

        # Regioni italiane ad alto rischio incendi
        high_risk_regions = [
            {"name": "Sardegna Sud", "lat": 39.2, "lon": 9.1, "risk": 0.8},
            {"name": "Sicilia Est", "lat": 37.5, "lon": 15.0, "risk": 0.9},
            {"name": "Calabria", "lat": 38.9, "lon": 16.6, "risk": 0.85},
            {"name": "Lazio Sud", "lat": 41.5, "lon": 13.0, "risk": 0.7},
            {"name": "Toscana", "lat": 43.4, "lon": 11.1, "risk": 0.6},
            {"name": "Liguria", "lat": 44.1, "lon": 8.5, "risk": 0.65},
            {"name": "Campania", "lat": 40.8, "lon": 14.3, "risk": 0.75}
        ]

        incidents = []
        np.random.seed(42)

        # Genera 5 anni di dati storici
        start_date = datetime(2019, 1, 1)
        end_date = datetime(2024, 1, 1)

        for region in high_risk_regions:
            # Numero incendi per regione basato su rischio
            n_incidents = int(region["risk"] * 200)  # 120-180 incendi per regione

            for _ in range(n_incidents):
                # Data casuale con bias stagionale
                days_since_start = np.random.randint(0, (end_date - start_date).days)
                fire_date = start_date + timedelta(days=days_since_start)

                # Bias stagionale: più incendi in estate
                month = fire_date.month
                if 6 <= month <= 9:  # Estate
                    if np.random.random() > 0.3:  # 70% degli incendi in estate
                        continue
                else:  # Altre stagioni
                    if np.random.random() > 0.7:  # 30% negli altri mesi
                        continue

                # Coordinate con variazione geografica
                lat = region["lat"] + np.random.normal(0, 0.3)
                lon = region["lon"] + np.random.normal(0, 0.3)

                # Area bruciata con distribuzione realistica
                burned_area = max(0.1, np.random.lognormal(2, 1.5))

                # Cause realistiche
                causes = ["human", "lightning", "arson", "accident", "natural"]
                cause_weights = [0.4, 0.15, 0.2, 0.2, 0.05]
                cause = np.random.choice(causes, p=cause_weights)

                # Condizioni meteo al momento dell'incendio
                base_temp = 15 + (50 - abs(lat)) * 0.6
                seasonal_temp = base_temp + math.sin(2 * math.pi * (fire_date.timetuple().tm_yday - 80) / 365) * 15
                temp = seasonal_temp + np.random.normal(0, 5)

                # Condizioni favorevoli agli incendi (bias verso condizioni critiche)
                if np.random.random() < 0.6:  # 60% in condizioni critiche
                    temp += np.random.uniform(5, 15)
                    humidity = np.random.uniform(10, 40)
                    wind = np.random.uniform(15, 45)
                    precip = np.random.uniform(0, 0.5)
                else:  # 40% in condizioni normali
                    humidity = np.random.uniform(40, 80)
                    wind = np.random.uniform(5, 20)
                    precip = np.random.uniform(0, 5)

                # Tempo di soppressione basato su severità
                if burned_area > 100:
                    severity = "extreme"
                    suppression_time = np.random.uniform(24, 168)  # 1-7 giorni
                elif burned_area > 20:
                    severity = "high"
                    suppression_time = np.random.uniform(8, 48)   # 8-48 ore
                elif burned_area > 5:
                    severity = "medium"
                    suppression_time = np.random.uniform(2, 12)   # 2-12 ore
                else:
                    severity = "low"
                    suppression_time = np.random.uniform(0.5, 4)  # 30min-4 ore

                vegetation_types = ["forest", "shrubland", "grassland", "mixed"]
                vegetation = np.random.choice(vegetation_types)

                incident = FireIncident(
                    date=fire_date,
                    latitude=lat,
                    longitude=lon,
                    burned_area_ha=burned_area,
                    cause=cause,
                    weather_temp=temp,
                    weather_humidity=humidity,
                    weather_wind=wind,
                    weather_precip=precip,
                    suppression_time_hours=suppression_time,
                    vegetation_type=vegetation,
                    severity=severity
                )
                incidents.append(incident)

        # Salva nel database
        self.bulk_insert_incidents(incidents)
        print(f"Added {len(incidents)} historical fire incidents to database")

    def add_incident(self, incident: FireIncident):
        """Aggiungi singolo incidente"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        cursor.execute('''
        INSERT INTO fire_incidents
        (date, latitude, longitude, burned_area_ha, cause, weather_temp,
         weather_humidity, weather_wind, weather_precip, suppression_time_hours,
         vegetation_type, severity)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ''', (
            incident.date.isoformat(),
            incident.latitude,
            incident.longitude,
            incident.burned_area_ha,
            incident.cause,
            incident.weather_temp,
            incident.weather_humidity,
            incident.weather_wind,
            incident.weather_precip,
            incident.suppression_time_hours,
            incident.vegetation_type,
            incident.severity
        ))

        conn.commit()
        conn.close()

    def bulk_insert_incidents(self, incidents: List[FireIncident]):
        """Inserimento bulk di incidenti"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        data = []
        for incident in incidents:
            data.append((
                incident.date.isoformat(),
                incident.latitude,
                incident.longitude,
                incident.burned_area_ha,
                incident.cause,
                incident.weather_temp,
                incident.weather_humidity,
                incident.weather_wind,
                incident.weather_precip,
                incident.suppression_time_hours,
                incident.vegetation_type,
                incident.severity
            ))

        cursor.executemany('''
        INSERT INTO fire_incidents
        (date, latitude, longitude, burned_area_ha, cause, weather_temp,
         weather_humidity, weather_wind, weather_precip, suppression_time_hours,
         vegetation_type, severity)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ''', data)

        conn.commit()
        conn.close()

    def get_incidents_by_region(self, lat: float, lon: float,
                              radius_km: float = 50,
                              years_back: int = 5) -> List[FireIncident]:
        """Ottieni incidenti in una regione e periodo"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        # Approssimazione semplice per raggio geografico
        lat_delta = radius_km / 111.0  # ~111km per grado di latitudine
        lon_delta = radius_km / (111.0 * math.cos(math.radians(lat)))

        start_date = (datetime.now() - timedelta(days=years_back * 365)).isoformat()

        cursor.execute('''
        SELECT * FROM fire_incidents
        WHERE latitude BETWEEN ? AND ?
        AND longitude BETWEEN ? AND ?
        AND date >= ?
        ORDER BY date DESC
        ''', (
            lat - lat_delta, lat + lat_delta,
            lon - lon_delta, lon + lon_delta,
            start_date
        ))

        rows = cursor.fetchall()
        conn.close()

        incidents = []
        for row in rows:
            incidents.append(FireIncident(
                date=datetime.fromisoformat(row[1]),
                latitude=row[2],
                longitude=row[3],
                burned_area_ha=row[4],
                cause=row[5],
                weather_temp=row[6],
                weather_humidity=row[7],
                weather_wind=row[8],
                weather_precip=row[9],
                suppression_time_hours=row[10],
                vegetation_type=row[11],
                severity=row[12]
            ))

        return incidents

    def get_seasonal_statistics(self, lat: float, lon: float,
                              radius_km: float = 100) -> Dict:
        """Statistiche stagionali per una regione"""
        incidents = self.get_incidents_by_region(lat, lon, radius_km, years_back=10)

        seasonal_stats = {
            'winter': {'count': 0, 'total_area': 0, 'avg_temp': 0, 'temps': []},
            'spring': {'count': 0, 'total_area': 0, 'avg_temp': 0, 'temps': []},
            'summer': {'count': 0, 'total_area': 0, 'avg_temp': 0, 'temps': []},
            'autumn': {'count': 0, 'total_area': 0, 'avg_temp': 0, 'temps': []}
        }

        season_map = {12: 'winter', 1: 'winter', 2: 'winter',
                     3: 'spring', 4: 'spring', 5: 'spring',
                     6: 'summer', 7: 'summer', 8: 'summer',
                     9: 'autumn', 10: 'autumn', 11: 'autumn'}

        for incident in incidents:
            season = season_map[incident.date.month]
            seasonal_stats[season]['count'] += 1
            seasonal_stats[season]['total_area'] += incident.burned_area_ha
            seasonal_stats[season]['temps'].append(incident.weather_temp)

        # Calcola medie
        for season in seasonal_stats:
            if seasonal_stats[season]['temps']:
                seasonal_stats[season]['avg_temp'] = np.mean(seasonal_stats[season]['temps'])
                seasonal_stats[season]['avg_area'] = seasonal_stats[season]['total_area'] / seasonal_stats[season]['count']

        return seasonal_stats

