# Importa le classi base dal sistema precedente (WeatherData, LocationData, etc.)
@dataclass
class WeatherData:
    temperature: float
    humidity: float
    wind_speed: float
    precipitation: float
    pressure: float = 1013.0
    dew_point: float = None
    solar_radiation: float = None
    uv_index: float = None
    visibility: float = 10.0

    def __post_init__(self):
        if self.dew_point is None:
            self.dew_point = self.temperature - ((100 - self.humidity) / 5)
        if self.solar_radiation is None:
            self.solar_radiation = max(0, 800 * math.sin(math.pi * (datetime.now().hour - 6) / 12))
        if self.uv_index is None:
            self.uv_index = max(0, 10 * math.sin(math.pi * (datetime.now().hour - 6) / 12))

@dataclass
class LocationData:
    latitude: float
    longitude: float
    elevation: float = 300.0
    vegetation_type: str = "mixed"
    slope: float = 0.0
    aspect: float = 180.0
    distance_to_road: float = 1000.0
    population_density: float = 100.0

class EnhancedFireRiskSystem:
    """Sistema integrato con validazione storica e feedback continuo"""

    def __init__(self):
        print("Initializing Enhanced Fire Risk System v3.0...")

        # Componenti principali
        self.historical_db = HistoricalFireDatabase()
        self.expert_system = ExpertValidationSystem()
        self.feedback_system = ContinuousFeedbackSystem()

        # Crea directory necessarie
        Path("validation_requests").mkdir(exist_ok=True)
        Path("models").mkdir(exist_ok=True)

        # Inizializza modello base (versione semplificata per demo)
        self._initialize_base_predictor()

        print("Enhanced system ready!")

    def _initialize_base_predictor(self):
        """Inizializza predittore base (semplificato per demo)"""
        self.predictor = SimpleFirePredictor()

    def predict_with_validation(self, latitude: float, longitude: float,
                               elevation: float = 300.0, vegetation_type: str = "mixed",
                               include_historical_context: bool = True,
                               submit_for_expert_review: bool = False) -> Dict:
        """Predizione con context storico e opzione validazione"""

        # Predizione base
        weather = self._get_mock_weather(latitude, longitude)
        location = LocationData(
            latitude=latitude, longitude=longitude, elevation=elevation,
            vegetation_type=vegetation_type
        )

        base_prediction = self.predictor.predict(weather, location)

        # Context storico
        historical_context = {}
        if include_historical_context:
            regional_incidents = self.historical_db.get_incidents_by_region(
                latitude, longitude, radius_km=50, years_back=5
            )
            seasonal_stats = self.historical_db.get_seasonal_statistics(
                latitude, longitude, radius_km=100
            )

            historical_context = {
                'incidents_last_5_years': len(regional_incidents),
                'avg_burned_area': np.mean([i.burned_area_ha for i in regional_incidents]) if regional_incidents else 0,
                'seasonal_stats': seasonal_stats,
                'most_common_cause': max([i.cause for i in regional_incidents],
                                       key=[i.cause for i in regional_incidents].count) if regional_incidents else "unknown"
            }

        # Sottoponi per revisione esperto se richiesto
        prediction_id = None
        if submit_for_expert_review:
            prediction_id = self.expert_system.submit_for_validation(
                base_prediction, location.__dict__, weather.__dict__
            )

        # Combina risultati
        enhanced_result = {
            **base_prediction,
            'prediction_id': prediction_id,
            'historical_context': historical_context,
            'system_version': '3.0',
            'timestamp': datetime.now().isoformat()
        }

        return enhanced_result

    def _get_mock_weather(self, lat: float, lon: float) -> WeatherData:
        """Mock weather data per demo"""
        season_factor = math.sin(2 * math.pi * (datetime.now().timetuple().tm_yday - 80) / 365)
        base_temp = 15 + (45 - abs(lat)) * 0.5 + season_factor * 15

        return WeatherData(
            temperature=base_temp + np.random.normal(0, 5),
            humidity=max(20, min(90, 70 + np.random.normal(0, 20))),
            wind_speed=max(0, 10 + np.random.normal(0, 8)),
            precipitation=max(0, np.random.exponential(1))
        )

    def run_comprehensive_validation(self) -> str:
        """Esegue validazione completa del sistema"""
        print("Running comprehensive system validation...")

        # 1. Validazione stagionale
        seasonal_validator = SeasonalValidationFramework(self, self.historical_db)
        seasonal_results = seasonal_validator.run_comprehensive_seasonal_validation()

        # 2. Genera validazioni esperto di esempio
        self.expert_system.generate_sample_validations(50)
        expert_agreement = self.expert_system.calculate_expert_agreement()

        # 3. Analisi performance feedback
        # Simula alcuni feedback per demo
        self._generate_sample_feedback()
        performance_analysis = self.feedback_system.analyze_prediction_accuracy()

        # 4. Report completo
        report = []
        report.append("="*80)
        report.append("COMPREHENSIVE VALIDATION REPORT")
        report.append("="*80)

        # Seasonal validation
        if seasonal_results and 'aggregate' in seasonal_results:
            agg = seasonal_results['aggregate']
            report.append(f"\nSEASONAL VALIDATION:")
            report.append(f"  Overall Accuracy: {agg.get('overall_accuracy', 0):.1%}")
            report.append(f"  Overall AUC-ROC: {agg.get('overall_auc_roc', 0):.3f}")
            report.append(f"  Total Samples: {agg.get('total_samples', 0)}")
            report.append(f"  Best Season: {agg.get('best_season', 'N/A')}")

        # Expert validation
        report.append(f"\nEXPERT VALIDATION:")
        report.append(f"  Expert Agreement Score: {expert_agreement.get('agreement_score', 0):.1%}")
        report.append(f"  Sample Size: {expert_agreement.get('sample_size', 0)}")
        report.append(f"  High Confidence Cases: {expert_agreement.get('high_confidence_cases', 0)}")

        # Performance feedback
        report.append(f"\nPERFORMANCE FEEDBACK:")
        report.append(f"  Recent Accuracy: {performance_analysis.get('overall_accuracy', 0):.1%}")
        report.append(f"  Feedback Samples: {performance_analysis.get('total_samples', 0)}")
        report.append(f"  Actual Fire Rate: {performance_analysis.get('actual_fire_rate', 0):.1%}")

        # Improvement suggestions
        suggestions = self.feedback_system.get_improvement_suggestions()
        report.append(f"\nIMPROVEMENT SUGGESTIONS:")
        for i, suggestion in enumerate(suggestions[:3], 1):
            report.append(f"  {i}. {suggestion}")

        report.append("="*80)
        return "\n".join(report)

    def _generate_sample_feedback(self):
        """Genera feedback di esempio per testing"""
        for i in range(25):
            # Simula predizioni con outcome reali
            predicted_prob = np.random.uniform(0.1, 0.9)
            predicted_level = "CRITICO" if predicted_prob > 0.8 else \
                            "ALTO" if predicted_prob > 0.6 else \
                            "MEDIO" if predicted_prob > 0.4 else "BASSO"

            # Outcome correlato alla predizione (con rumore)
            fire_occurred = np.random.random() < (predicted_prob * 0.8 + 0.1)

            self.feedback_system.record_prediction_outcome(
                prediction_id=f"demo_pred_{i:03d}",
                predicted_prob=predicted_prob,
                predicted_level=predicted_level,
                actual_outcome=fire_occurred,
                feedback_source="field_report"
            )

class SimpleFirePredictor:
    """Predittore semplificato per demo del sistema integrato"""

    def predict(self, weather: WeatherData, location: LocationData) -> Dict:
        """Predizione semplificata"""

        # Calcolo rischio base su fattori chiave
        temp_factor = min(1.0, max(0.0, (weather.temperature - 20) / 25))
        humidity_factor = min(1.0, max(0.0, (60 - weather.humidity) / 50))
        wind_factor = min(1.0, weather.wind_speed / 30)
        dry_factor = 1.0 if weather.precipitation < 0.5 else max(0.1, 1 - weather.precipitation / 5)

        vegetation_risk = {"forest": 0.3, "grassland": 0.8, "shrubland": 0.9, "mixed": 0.5, "urban": 0.1}
        veg_factor = vegetation_risk.get(location.vegetation_type, 0.5)

        fire_probability = (
            temp_factor * 0.3 +
            humidity_factor * 0.3 +
            wind_factor * 0.2 +
            dry_factor * 0.15 +
            veg_factor * 0.05
        )

        # Aggiungi variazione casuale
        fire_probability += np.random.normal(0, 0.05)
        fire_probability = max(0.01, min(0.98, fire_probability))

        # Determina livello rischio
        if fire_probability >= 0.8:
            risk_level = "CRITICO"
        elif fire_probability >= 0.6:
            risk_level = "ALTO"
        elif fire_probability >= 0.4:
            risk_level = "MEDIO"
        else:
            risk_level = "BASSO"

        return {
            'fire_probability': fire_probability,
            'risk_level': risk_level,
            'confidence_score': 0.85,
            'contributing_factors': {
                'Temperature': temp_factor,
                'Humidity': humidity_factor,
                'Wind': wind_factor,
                'Dryness': dry_factor,
                'Vegetation': veg_factor
            }
        }

