class ContinuousFeedbackSystem:
    """Sistema per miglioramento continuo del modello"""

    def __init__(self, model_path: str = "models/"):
        self.model_path = Path(model_path)
        self.model_path.mkdir(exist_ok=True)
        self.feedback_db_path = "feedback.db"
        self.performance_history = []
        self._init_feedback_database()

    def _init_feedback_database(self):
        """Inizializza database feedback"""
        conn = sqlite3.connect(self.feedback_db_path)
        cursor = conn.cursor()

        cursor.execute('''
        CREATE TABLE IF NOT EXISTS prediction_feedback (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            prediction_id TEXT NOT NULL,
            predicted_probability REAL NOT NULL,
            predicted_risk_level TEXT NOT NULL,
            actual_outcome INTEGER,  -- 0=no fire, 1=fire occurred
            feedback_source TEXT,    -- expert, automated, field_report
            feedback_date TEXT NOT NULL,
            location_lat REAL,
            location_lon REAL,
            weather_conditions TEXT, -- JSON
            model_version TEXT,
            confidence_score REAL,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
        ''')

        cursor.execute('''
        CREATE TABLE IF NOT EXISTS model_performance (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            date TEXT NOT NULL,
            model_version TEXT NOT NULL,
            accuracy REAL,
            precision_score REAL,
            recall_score REAL,
            auc_roc REAL,
            n_samples INTEGER,
            improvement_notes TEXT,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
        ''')

        conn.commit()
        conn.close()

    def record_prediction_outcome(self, prediction_id: str, predicted_prob: float,
                                predicted_level: str, actual_outcome: bool,
                                feedback_source: str = "field_report",
                                location: tuple = None, weather: dict = None,
                                model_version: str = "3.0"):
        """Registra outcome reale di una predizione"""
        conn = sqlite3.connect(self.feedback_db_path)
        cursor = conn.cursor()

        cursor.execute('''
        INSERT INTO prediction_feedback
        (prediction_id, predicted_probability, predicted_risk_level, actual_outcome,
         feedback_source, feedback_date, location_lat, location_lon,
         weather_conditions, model_version, confidence_score)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        ''', (
            prediction_id,
            predicted_prob,
            predicted_level,
            1 if actual_outcome else 0,
            feedback_source,
            datetime.now().isoformat(),
            location[0] if location else None,
            location[1] if location else None,
            json.dumps(weather) if weather else None,
            model_version,
            0.8  # Default confidence
        ))

        conn.commit()
        conn.close()

        print(f"Recorded outcome for prediction {prediction_id}: {'FIRE' if actual_outcome else 'NO FIRE'}")

    def analyze_prediction_accuracy(self, days_back: int = 30) -> Dict:
        """Analizza accuratezza delle predizioni recenti"""
        conn = sqlite3.connect(self.feedback_db_path)
        cursor = conn.cursor()

        cutoff_date = (datetime.now() - timedelta(days=days_back)).isoformat()

        cursor.execute('''
        SELECT predicted_probability, actual_outcome, predicted_risk_level
        FROM prediction_feedback
        WHERE feedback_date >= ? AND actual_outcome IS NOT NULL
        ''', (cutoff_date,))

        results = cursor.fetchall()
        conn.close()

        if not results:
            return {"message": "No feedback data available", "accuracy": 0.0}

        predictions = [r[0] for r in results]
        actuals = [r[1] for r in results]
        risk_levels = [r[2] for r in results]

        # Calcola metriche
        pred_binary = [1 if p >= 0.5 else 0 for p in predictions]
        accuracy = sum(1 for p, a in zip(pred_binary, actuals) if p == a) / len(actuals)

        # Analisi per livello di rischio
        risk_analysis = {}
        for level in ['BASSO', 'MEDIO', 'ALTO', 'CRITICO']:
            level_indices = [i for i, r in enumerate(risk_levels) if r == level]
            if level_indices:
                level_accuracy = sum(1 for i in level_indices if pred_binary[i] == actuals[i]) / len(level_indices)
                risk_analysis[level] = {
                    'accuracy': level_accuracy,
                    'samples': len(level_indices),
                    'fire_rate': sum(actuals[i] for i in level_indices) / len(level_indices)
                }

        return {
            "overall_accuracy": accuracy,
            "total_samples": len(results),
            "days_analyzed": days_back,
            "risk_level_analysis": risk_analysis,
            "avg_predicted_prob": np.mean(predictions),
            "actual_fire_rate": np.mean(actuals)
        }

    def trigger_model_retraining(self, min_new_samples: int = 100) -> bool:
        """Verifica se serve retraining del modello"""
        conn = sqlite3.connect(self.feedback_db_path)
        cursor = conn.cursor()

        # Conta nuovi feedback dall'ultimo retraining
        cursor.execute('''
        SELECT COUNT(*) FROM prediction_feedback
        WHERE actual_outcome IS NOT NULL
        ''')

        new_samples = cursor.fetchone()[0]
        conn.close()

        if new_samples >= min_new_samples:
            print(f"Triggering model retraining with {new_samples} new samples")
            return True
        else:
            print(f"Not enough new samples ({new_samples}/{min_new_samples}) for retraining")
            return False

    def get_improvement_suggestions(self) -> List[str]:
        """Genera suggerimenti per miglioramenti del modello"""
        accuracy_analysis = self.analyze_prediction_accuracy(days_back=60)
        suggestions = []

        if accuracy_analysis.get("overall_accuracy", 0) < 0.8:
            suggestions.append("Overall accuracy below 80% - consider model retraining")

        risk_analysis = accuracy_analysis.get("risk_level_analysis", {})

        for level, metrics in risk_analysis.items():
            if metrics["accuracy"] < 0.7:
                suggestions.append(f"Low accuracy for {level} risk level ({metrics['accuracy']:.2f}) - review threshold calibration")

            if level == "CRITICO" and metrics["fire_rate"] < 0.8:
                suggestions.append("Critical risk predictions showing low actual fire rate - possible over-sensitivity")

        if len(suggestions) == 0:
            suggestions.append("Model performance looks good - continue monitoring")

        return suggestions

    def generate_performance_report(self) -> str:
        """Genera report performance dettagliato"""
        accuracy_data = self.analyze_prediction_accuracy(days_back=90)
        suggestions = self.get_improvement_suggestions()

        report = []
        report.append("="*60)
        report.append("MODEL PERFORMANCE REPORT")
        report.append("="*60)

        report.append(f"\nOVERALL METRICS (last 90 days):")
        report.append(f"  Accuracy: {accuracy_data.get('overall_accuracy', 0):.1%}")
        report.append(f"  Samples: {accuracy_data.get('total_samples', 0)}")
        report.append(f"  Avg Predicted Probability: {accuracy_data.get('avg_predicted_prob', 0):.3f}")
        report.append(f"  Actual Fire Rate: {accuracy_data.get('actual_fire_rate', 0):.1%}")

        report.append(f"\nRISK LEVEL PERFORMANCE:")
        risk_analysis = accuracy_data.get('risk_level_analysis', {})
        for level, metrics in risk_analysis.items():
            report.append(f"  {level}:")
            report.append(f"    Accuracy: {metrics['accuracy']:.1%}")
            report.append(f"    Samples: {metrics['samples']}")
            report.append(f"    Fire Rate: {metrics['fire_rate']:.1%}")

        report.append(f"\nIMPROVEMENT SUGGESTIONS:")
        for i, suggestion in enumerate(suggestions, 1):
            report.append(f"  {i}. {suggestion}")

        report.append("="*60)
        return "\n".join(report)

